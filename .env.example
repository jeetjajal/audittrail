# ==============================================================================
# AUDITTRAIL AI v2.1.0 — ENVIRONMENT TEMPLATE & DEPLOYMENT CONFIGURATION
# Medical Device eQMS (21 CFR Part 11, 21 CFR Part 820 / QMSR, ISO 13485:2016)
# ==============================================================================

# Core Runtime Environment
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# PostgreSQL 18.6 Connection (Use unprivileged application role audittrail_app)
DATABASE_URL=postgres://audittrail_app:<SECURE_PASSWORD>@localhost:5432/audittrail_dev

# Atlassian Forge Remote & FIT Verification
FORGE_APP_ID=c8b9d31e-4512-4cf0-8ef5-9a842f1b0a11
FORGE_APP_ARI=ari:cloud:ecosystem::app/c8b9d31e-4512-4cf0-8ef5-9a842f1b0a11
FORGE_JWKS_URL=https://forge.cdn.prod.atlassian-dev.net/.well-known/jwks.json
REMOTE_BACKEND_URL=https://api.audittrail.ai

# AWS S3 Evidence Storage & Object Lock (WORM - Write Once, Read Many)
# In local development without AWS, system safely falls back to local simulation
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_WORM_BUCKET=audittrail-compliance-records-worm
S3_OBJECT_LOCK_ENABLED=true
S3_OBJECT_LOCK_MODE=GOVERNANCE
S3_RETENTION_YEARS=10
# S3_ENDPOINT=http://localhost:4566  # Optional for LocalStack / MinIO

# AI & Decision Support Engine (Google Cloud Vertex AI)
# In local development without GCP, system seamlessly uses REAL[] cosine similarity engine
VERTEX_AI_PROJECT_ID=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1
