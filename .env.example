# AUDITTRAIL AI — Environment Template
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# PostgreSQL Connection String (Use least-privilege application role)
DATABASE_URL=postgres://audittrail_app:<SECURE_PASSWORD>@localhost:5432/audittrail_dev

# Atlassian Forge Configuration
FORGE_APP_ID=your-forge-app-id
FORGE_APP_ARI=ari:cloud:ecosystem::app/your-forge-app-id
FORGE_JWKS_URL=https://forge.cdn.prod.atlassian-dev.net/.well-known/jwks.json

# Storage & AI Engine
S3_WORM_BUCKET=your-compliance-worm-bucket
VERTEX_AI_LOCATION=us-central1
